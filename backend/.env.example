DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/citizen_complaints
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/citizen_complaints_test
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
